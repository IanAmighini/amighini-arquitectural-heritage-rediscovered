# ------------------------------------------------------------------
# Amighini Arquitectural — configuración Apache para Plesk
# Este archivo se copia a dist/ en cada build. Subilo junto con el
# resto de dist/ a la carpeta httpdocs del dominio.
# ------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Una sola versión del sitio: https://amighini.com.ar (sin www).
  #    Evita contenido duplicado en Google.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://amighini.com.ar%{REQUEST_URI} [L,R=301,NE]

  # 2) /index.html -> /  (evita dos URLs para la misma página)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# 3) Página 404 real (código 404, no una página vacía con código 200)
ErrorDocument 404 /404.html

# 4) Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml image/x-icon
</IfModule>

# 5) Caché del navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Los archivos de /assets llevan un hash en el nombre: se pueden cachear para siempre.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Seguridad básica
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
